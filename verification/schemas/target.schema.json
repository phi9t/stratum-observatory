{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STRATUM target registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "claims",
    "contracts",
    "runtime_obligations"
  ],
  "properties": {
    "schema": {
      "enum": [
        "stratum-target/v1"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "classification",
          "statement",
          "evidence",
          "dependencies"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "documented",
              "derived",
              "assumed",
              "presentation"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "expected": {},
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "anchor",
                "relation"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "anchor": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "json_pointer",
                        "python_symbol",
                        "span",
                        "text_quote"
                      ]
                    },
                    "pointer": {
                      "type": "string"
                    },
                    "transform": {
                      "enum": [
                        "identity",
                        "length"
                      ]
                    },
                    "symbol": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "integer"
                    },
                    "end": {
                      "type": "integer"
                    },
                    "contains": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "resolved_span": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "relation": {
                  "enum": [
                    "equal",
                    "consumes",
                    "implements",
                    "documents",
                    "derives"
                  ]
                }
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "record",
          "claims",
          "bindings"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "record": {
            "type": "object"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bindings": {
            "type": "object"
          }
        }
      },
      "minItems": 1
    },
    "runtime_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "description",
          "environment"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contract": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
