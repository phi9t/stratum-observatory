{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STRATUM source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sources"
  ],
  "properties": {
    "schema": {
      "enum": [
        "stratum-sources/v1"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "role",
          "url",
          "sha256",
          "cache",
          "license"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "git",
              "document"
            ]
          },
          "role": {
            "enum": [
              "publisher_config",
              "publisher_code",
              "framework_code",
              "vendor_document",
              "library_code",
              "paper",
              "tokenizer_code",
              "checkpoint_metadata",
              "methodology_reference"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "cache": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "enum": [
              "github",
              "huggingface"
            ]
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "fixture": {
            "type": "boolean"
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1
          },
          "etag": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "minItems": 1
    }
  }
}
