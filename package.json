{
  "name": "stratum-model-systems-observatory",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node build.mjs",
    "start": "npm run build && uv run --frozen python -m http.server 8000 --directory dist",
    "verify": "npm run verify:engineering && npm run verify:schematics && npm run verify:aesthetics && npm run verify:presentations && npm run verify:science",
    "test:verifiers": "uv run --frozen python -m unittest discover -s verification/tests -v",
    "verify:engineering": "uv run --frozen python -m verification.engineering",
    "verify:schematics": "uv run --frozen python -m verification.schematics",
    "verify:aesthetics": "uv run --frozen python -m verification.aesthetics",
    "verify:presentations": "uv run --frozen python -m verification.presentations",
    "verify:science": "uv run --frozen python -m verification.runner --profile publication",
    "verify:runtime": "uv run --frozen python -m verification.runner --profile runtime",
    "verify:sources": "uv run --frozen python -m verification.sources acquire",
    "capture": "uv run --frozen python tests/capture.py",
    "verify:accounting": "uv run --frozen python -m verification.accounting",
    "verify:privacy": "uv run --frozen python -m verification.privacy",
    "package:public": "uv run --frozen python tools/export-public.py",
    "test:pytorch": "uv run --frozen --group examples python -m unittest discover -s tests -p \"pytorch_*.py\" -v",
    "validate:pytorch": "uv run --frozen --group examples python -m examples.deepseek_v41.validate"
  },
  "engines": {
    "node": ">=20"
  }
}
